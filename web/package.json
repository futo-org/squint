    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@immich/ui": "^0.94.0",
    "@futo-org/squint-sdk": "workspace:*",
