{
  "name": "squint-server",
  "version": "0.0.0",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build && pnpm open-api && pnpm --filter @futo-org/squint-sdk generate",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --",
    "check": "tsc --noEmit && sql-tools migrations verify-order",
    "test": "vitest --config test/vitest.config.mjs",
    "test:medium": "vitest --config test/vitest.config.medium.mjs",
    "open-api": "node dist/bin/sync-open-api.js",
    "release-notes": "node dist/bin/release-notes.js",
    "migrations:generate": "sql-tools -u ${SQUINT_DB_URL:-postgres://postgres:postgres@localhost:5432/squint} migrations generate",
    "migrations:create": "sql-tools -u ${SQUINT_DB_URL:-postgres://postgres:postgres@localhost:5432/squint} migrations create",
    "migrations:run": "sql-tools -u ${SQUINT_DB_URL:-postgres://postgres:postgres@localhost:5432/squint} migrations run",
    "migrations:revert": "sql-tools -u ${SQUINT_DB_URL:-postgres://postgres:postgres@localhost:5432/squint} migrations revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@immich/sql-tools": "^0.7.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "^12.5.1",
    "cookie": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^5.0.0",
    "nestjs-kysely": "3.1.5",
    "openid-client": "^6.9.0",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sirv": "^3.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.4.14",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.0",
    "testcontainers": "^12.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
