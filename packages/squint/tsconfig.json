{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2024",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"]
}
