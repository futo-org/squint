{
  "name": "@futo-org/squint",
  "description": "Publish screenshots to Squint for visual regression review",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futo-org/squint.git",
    "directory": "packages/squint"
  },
  "scripts": {
    "build": "vite build && publint",
    "check": "tsc --noEmit",
    "test": "vitest"
  },
  "type": "module",
  "bin": {
    "squint": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "dependencies": {
    "odiff-bin": "^4.5.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@futo-org/squint-sdk": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "publint": "^0.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
